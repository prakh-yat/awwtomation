// Awwtomation: multi-tenant Instagram & Facebook comment-to-DM automation platform.
// Organizations are the billable tenant; every workspace-owned row carries workspaceId and all reads MUST be scoped by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  PRO
  AGENCY
}

enum ChannelPlatform {
  INSTAGRAM
  FACEBOOK
}

enum ChannelStatus {
  ACTIVE
  TOKEN_EXPIRED
  DISCONNECTED
  ERROR
}

/// Which API shape a bring-your-own-key provider speaks.
enum AiProviderKind {
  /// Anything that serves POST /v1/chat/completions: OpenAI, Groq, OpenRouter,
  /// DeepSeek, Together, Mistral, vLLM, LM Studio, Ollama behind a proxy.
  OPENAI_COMPATIBLE
  /// Anthropic Messages API.
  ANTHROPIC
  /// Google Generative Language API.
  GOOGLE
}

enum AiProviderStatus {
  ACTIVE
  /// The last call was refused for a reason the key owner has to fix.
  INVALID_KEY
  ERROR
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// COMMENT: comment on a post/reel (IG) or page post (FB).
/// DM: an inbound direct message containing a keyword.
/// STORY_REPLY: a reply to an IG story (arrives as a DM with a story reference).
enum TriggerType {
  COMMENT
  DM
  STORY_REPLY
}

/// CONTAINS: keyword appears anywhere (case-insensitive). EXACT: whole-word match.
/// ANY: fire on every comment/message regardless of text.
enum MatchMode {
  CONTAINS
  EXACT
  ANY
}

enum JobType {
  EXECUTE_FLOW
  PUBLIC_REPLY
  BROADCAST_SEND
  REFRESH_TOKEN
  RECONCILE_COMMENTS
  SYNC_MEDIA
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED_DUPLICATE
  SKIPPED_RATE_LIMIT
  SKIPPED_SELF
  SKIPPED_NOT_FOLLOWING
  SKIPPED_WINDOW
  SKIPPED_PLAN_LIMIT
  SKIPPED_OPTED_OUT
}

enum DeliveryKind {
  PRIVATE_REPLY
  MESSAGE
  PUBLIC_REPLY
  BROADCAST
}

/// How a contact entered the workspace. Only WEBHOOK contacts carry a real Meta
/// id and can be messaged; IMPORT/MANUAL records are CRM-only until the person
/// interacts with the account (at which point they are merged by username).
enum ContactSource {
  WEBHOOK
  IMPORT
  MANUAL
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum BillingStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  ON_HOLD
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

/// Where the workspace's plan comes from. ADMIN_OVERRIDE wins over webhook syncs.
enum PlanSource {
  DEFAULT
  SUBSCRIPTION
  ADMIN_OVERRIDE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  DISPUTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum FlowSessionStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

enum OAuthTokenKind {
  ACCESS
  REFRESH
}

// ───────────────────────── Identity & tenancy ─────────────────────────

model User {
  id           String   @id @default(cuid())
  /// External identity, namespaced by provider: "google:<sub>" (or "dev:<email>"
  /// for the local bypass). Still stored in the column Supabase auth used, so
  /// switching providers needed no migration and existing rows kept their data.
  authId       String   @unique @map("supabaseId")
  email        String   @unique
  name         String?
  avatarUrl    String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships           OrganizationMember[]
  sentInvitations       Invitation[]         @relation("InvitedBy")
  connectedChannels     Channel[]            @relation("ConnectedBy")
  sentMessages          Message[]
  assignedConversations Conversation[]       @relation("AssignedTo")
  ownedContacts         Contact[]            @relation("ContactOwner")
  contactNotes          ContactNote[]
  auditLogs             AuditLog[]
  oauthGrants           OAuthGrant[]
  oauthCodes            OAuthCode[]
  oauthTokens           OAuthToken[]
}

/// The billable account. Holds the plan, the monthly DM counter, the team and
/// payments; every workspace inside it shares those limits. One person can
/// belong to several organizations and switch between them.
model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  plan              PlanTier @default(FREE)
  /// DMs sent across all of the organization's workspaces in the current billing period (reset monthly by lib/billing/usage.ts).
  dmsSentThisPeriod Int      @default(0)
  usagePeriodStart  DateTime @default(now())

  // ── Billing (Dodo Payments) ──
  planSource            PlanSource       @default(DEFAULT)
  billingStatus         BillingStatus    @default(NONE)
  billingInterval       BillingInterval?
  billingCustomerId     String?
  billingSubscriptionId String?          @unique
  billingEmail          String?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean          @default(false)
  /// Plan the subscription is for (mirrors `plan` unless an admin override is active).
  subscribedPlan        PlanTier?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  invitations Invitation[]
  workspaces  Workspace[]
  payments    Payment[]
  oauthGrants OAuthGrant[]
  mcpTools    McpToolAccess[]
}

/// Roles are organization-wide: a member can open every workspace in the organization.
model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           WorkspaceRole @default(MEMBER)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           WorkspaceRole    @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

/// A brand or client inside an organization: its own connected accounts,
/// automations, contacts and pipelines.
model Workspace {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String    @unique
  timezone       String    @default("Asia/Kathmandu")
  /// Set the moment the first channel is connected.
  onboardedAt    DateTime?
  /// Answers to the welcome questionnaire, keyed by question id. Single-choice
  /// answers are strings, multi-choice answers are arrays of strings.
  onboardingAnswers Json?
  /// Set when the questionnaire is finished or skipped, so it is only asked once.
  onboardingCompletedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  segments        Segment[]
  contactNotes    ContactNote[]
  channels        Channel[]
  automations     Automation[]
  contacts        Contact[]
  conversations   Conversation[]
  broadcasts      Broadcast[]
  deliveryLogs    DeliveryLog[]
  trackedLinks    TrackedLink[]
  flowSessions    FlowSession[]
  pipelines       Pipeline[]
  pipelineEntries PipelineEntry[]
  jobs            Job[]
  aiProviders     AiProvider[]
  aiAgents        AiAgent[]
  auditLogs       AuditLog[]

  @@index([organizationId])
}

// ───────────────────────── Channels (connected accounts) ─────────────────────────

/// A connected Instagram professional account or Facebook Page.
/// One external account can only be connected to ONE workspace at a time.
model Channel {
  id                String          @id @default(cuid())
  workspaceId       String
  platform          ChannelPlatform
  /// IG professional account id (Instagram Login) or Facebook Page id.
  externalId        String
  username          String?
  name              String?
  avatarUrl         String?
  /// AES-256-GCM encrypted (lib/crypto.ts). IG: long-lived user token. FB: page access token.
  accessTokenEnc    String
  tokenExpiresAt    DateTime?
  /// FB only: the Instagram business account linked to the page, if any.
  linkedInstagramId String?
  scopes            String[]        @default([])
  status            ChannelStatus   @default(ACTIVE)
  webhookSubscribed Boolean         @default(false)
  followerCount     Int?
  lastSyncedAt      DateTime?
  lastError         String?
  connectedById     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?     @relation("ConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)

  media         Media[]
  automations   Automation[]
  contacts      Contact[]
  conversations Conversation[]
  broadcasts    Broadcast[]
  deliveryLogs  DeliveryLog[]
  rateLimits    RateLimitWindow[]

  @@unique([platform, externalId])
  @@index([workspaceId])
}

/// Cached posts/reels so the post picker loads instantly.
model Media {
  id           String    @id @default(cuid())
  channelId    String
  externalId   String
  caption      String?
  mediaType    String?
  mediaUrl     String?
  thumbnailUrl String?
  permalink    String?
  timestamp    DateTime?
  commentCount Int?
  likeCount    Int?
  syncedAt     DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalId])
}

// ───────────────────────── Automations & flows ─────────────────────────

model Automation {
  id                 String           @id @default(cuid())
  workspaceId        String
  channelId          String
  name               String
  status             AutomationStatus @default(DRAFT)
  triggerType        TriggerType      @default(COMMENT)
  matchMode          MatchMode        @default(CONTAINS)
  keywords           String[]         @default([])
  excludeKeywords    String[]         @default([])
  /// External media ids this automation listens on. Empty = all posts.
  mediaIds           String[]         @default([])
  /// Flow graph: { nodes: FlowNode[], edges: FlowEdge[] }, see lib/automation/flow-types.ts
  flow               Json
  publicReplyEnabled Boolean          @default(false)
  /// One is picked at random per comment so replies don't look robotic.
  publicReplies      String[]         @default([])
  /// Only send once per contact per automation.
  oncePerContact     Boolean          @default(true)
  triggeredCount     Int              @default(0)
  sentCount          Int              @default(0)
  lastTriggeredAt    DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]
  flowSessions FlowSession[]
  trackedLinks TrackedLink[]

  @@index([workspaceId])
  @@index([channelId, status])
}

/// Tracks where a contact is inside a flow. A flow pauses after every
/// message; it resumes when the contact taps a button / replies.
model FlowSession {
  id            String            @id @default(cuid())
  workspaceId   String
  automationId  String
  contactId     String
  currentNodeId String?
  status        FlowSessionStatus @default(ACTIVE)
  /// Arbitrary state: { commentId, mediaId, triggerText, vars: {...} }
  context       Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, status])
  @@index([automationId])
}

// ───────────────────────── Contacts & inbox ─────────────────────────

model Contact {
  id           String          @id @default(cuid())
  workspaceId  String
  channelId    String
  platform     ChannelPlatform
  /// IGSID (Instagram-scoped id) or PSID (page-scoped id).
  externalId   String
  username     String?
  name         String?
  avatarUrl    String?
  isFollower   Boolean?
  tags         String[]        @default([])
  customFields Json            @default("{}")
  optedOut     Boolean         @default(false)

  // ── CRM ──
  source          ContactSource @default(WEBHOOK)
  /// False for imported/manual records without a Meta id (cannot be DMed).
  messageable     Boolean       @default(true)
  email           String?
  phone           String?
  ownerId         String?
  lastContactedAt DateTime?
  notesCount      Int           @default(0)

  firstSeenAt       DateTime  @default(now())
  lastInteractionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  owner           User?           @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversations   Conversation[]
  flowSessions    FlowSession[]
  deliveryLogs    DeliveryLog[]
  linkClicks      LinkClick[]
  notes           ContactNote[]
  pipelineEntries PipelineEntry[]

  @@unique([channelId, externalId])
  @@index([workspaceId, lastInteractionAt])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, email])
}

/// Free-text CRM notes on a contact, newest first.
model ContactNote {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactId, createdAt])
  @@index([workspaceId])
}

/// A sales or support funnel. A workspace can have several; a contact can sit in
/// any number of them, at one stage each, or in none.
model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  entries   PipelineEntry[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  name       String
  /// A key from STAGE_COLORS in lib/pipelines/colors.ts, e.g. "blue".
  color      String   @default("gray")
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pipeline Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  entries  PipelineEntry[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
}

/// Where one contact sits in one pipeline. `updatedAt` moves with every stage change.
model PipelineEntry {
  id          String   @id @default(cuid())
  workspaceId String
  pipelineId  String
  stageId     String
  contactId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, contactId])
  @@index([workspaceId, stageId])
  @@index([contactId])
}

model Conversation {
  id                 String             @id @default(cuid())
  workspaceId        String
  channelId          String
  contactId          String
  externalId         String?
  status             ConversationStatus @default(OPEN)
  /// Last INBOUND message time: the 24h messaging window is measured from this.
  lastInboundAt      DateTime?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int                @default(0)
  assignedToId       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@unique([channelId, contactId])
  @@index([workspaceId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  /// Meta message id (mid). Unique for idempotent webhook ingestion.
  externalId     String?          @unique
  text           String?
  /// Attachments, buttons, story refs, postback payloads: see lib/meta/types.ts
  payload        Json?
  /// Set when a human sent it from the Inbox.
  sentByUserId   String?
  /// Set when an automation sent it.
  automationId   String?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// ───────────────────────── Broadcasts ─────────────────────────

model Broadcast {
  id           String          @id @default(cuid())
  workspaceId  String
  channelId    String
  name         String
  /// OutboundMessage shape: see lib/meta/types.ts
  message      Json
  /// { tags: string[], excludeTags: string[], onlyFollowers?: boolean }
  audience     Json            @default("{}")
  status       BroadcastStatus @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  targetCount  Int             @default(0)
  sentCount    Int             @default(0)
  failedCount  Int             @default(0)
  skippedCount Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]
  trackedLinks TrackedLink[]

  @@index([workspaceId])
}

// ───────────────────────── Billing ─────────────────────────

/// Raw billing webhook receipts for idempotency (one row per provider event id).
model BillingEvent {
  id          String    @id @default(cuid())
  provider    String    @default("dodo")
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

/// Payment history shown on Settings → Billing.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  provider       String        @default("dodo")
  externalId     String        @unique
  subscriptionId String?
  amountCents    Int
  currency       String        @default("USD")
  status         PaymentStatus
  description    String?
  invoiceUrl     String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ───────────────────────── Segments ─────────────────────────

/// A saved contact filter. Filters JSON: { tags?: string[]; excludeTags?: string[];
/// onlyFollowers?: boolean; channelId?: string; lastInteractionDays?: number;
/// excludeOptedOut?: boolean; q?: string }, evaluated by lib/services/contacts.ts.
model Segment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  filters     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ───────────────────────── Delivery, links, logs ─────────────────────────

model DeliveryLog {
  id                  String         @id @default(cuid())
  workspaceId         String
  channelId           String
  automationId        String?
  broadcastId         String?
  contactId           String?
  kind                DeliveryKind
  status              DeliveryStatus
  /// The comment that triggered this (for dedupe: one private reply per comment).
  commentExternalId   String?
  recipientExternalId String?
  recipientUsername   String?
  messagePreview      String?
  errorMessage        String?
  metaResponse        Json?
  createdAt           DateTime       @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel    Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  broadcast  Broadcast?  @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([automationId, createdAt])
  @@index([channelId, commentExternalId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String?
  broadcastId    String?
  slug           String   @unique
  label          String?
  destinationUrl String
  clickCount     Int      @default(0)
  createdAt      DateTime @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)
  broadcast  Broadcast?  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
}

model LinkClick {
  id        String   @id @default(cuid())
  linkId    String
  contactId String?
  userAgent String?
  ipHash    String?
  createdAt DateTime @default(now())

  link    TrackedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([linkId, createdAt])
}

/// Raw webhook receipts for idempotency + debugging. `dedupeKey` is a stable
/// hash of the event (mid / comment id / etc).
model WebhookEvent {
  id        String          @id @default(cuid())
  platform  ChannelPlatform
  dedupeKey String          @unique
  field     String?
  payload   Json
  processed Boolean         @default(false)
  error     String?
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

/// Hourly counter for Meta's 750 private replies / hour / account cap.
model RateLimitWindow {
  id          String   @id @default(cuid())
  channelId   String
  bucket      String   @default("private_reply")
  windowStart DateTime
  count       Int      @default(0)

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, bucket, windowStart])
}

// ───────────────────────── Job queue (Postgres-backed) ─────────────────────────

model Job {
  id          String    @id @default(cuid())
  workspaceId String?
  type        JobType
  payload     Json
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  /// Optional idempotency key (e.g. `flow:${automationId}:${commentId}`).
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// ───────────────────────── AI (bring your own key) ─────────────────────────

/// A model provider the workspace pays for directly.
///
/// The key is theirs: it is encrypted at rest with APP_ENCRYPTION_KEY, only
/// ever decrypted inside the worker or a server action, and never returned to
/// the browser. Nothing about the model call is billed by us, which is why the
/// workspace picks the provider, the endpoint and the model itself.
model AiProvider {
  id          String           @id @default(cuid())
  workspaceId String
  label       String
  kind        AiProviderKind
  /// AES-256-GCM (lib/crypto.ts).
  apiKeyEnc   String
  /// Last four characters of the key, so the UI can show which one is saved.
  keyHint     String
  /// Overrides the provider default. Required for self-hosted endpoints.
  baseUrl     String?
  /// Model id as the provider spells it, e.g. "gpt-4o-mini", "claude-haiku-4-5", "gemini-2.0-flash".
  model       String
  status      AiProviderStatus @default(ACTIVE)
  lastError   String?
  lastUsedAt  DateTime?
  /// True for the provider new agents are created against.
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    AiAgent[]

  @@index([workspaceId])
}

/// A configured assistant: the prompt, the rules and the model settings.
///
/// Everything a reply is made of lives here and is editable, so the behaviour
/// of the bot is entirely the workspace's to decide. `systemPrompt` is theirs
/// verbatim; `guardrails` is appended after it so a hard rule cannot be talked
/// out of by the prompt above it.
model AiAgent {
  id           String  @id @default(cuid())
  workspaceId  String
  providerId   String?
  /// Model id for this agent, as the provider spells it. Null uses the provider's default model.
  model        String?
  name         String
  /// The whole persona, in the workspace's own words.
  systemPrompt String
  /// Facts pasted in verbatim: prices, hours, policies, links.
  knowledge    String?
  /// Rules appended after the prompt, such as "never quote a price".
  guardrails   String?
  /// Sent when the model call fails, so a contact is never left on silence.
  fallbackReply String?
  /// Link buttons the agent is allowed to attach, as [{ title, url }].
  ///
  /// The model names one by its title and we supply the URL, so it can make a
  /// reply interactive without ever inventing a link.
  buttons      Json?
  temperature  Float   @default(0.6)
  maxTokens    Int     @default(400)
  /// How many of the conversation's most recent messages are sent as context.
  historyLimit Int     @default(20)
  isDefault    Boolean @default(false)

  /// Lifetime counters, so the workspace can see what their key is spending.
  repliesSent      Int @default(0)
  promptTokens     Int @default(0)
  completionTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([providerId])
}

// ───────────────────────── MCP (OAuth for AI apps) ─────────────────────────

/// An AI app (Claude, ChatGPT, Cursor and the like) that registered itself at
/// /oauth/register (RFC 7591) to reach the MCP server at /mcp. Nobody creates
/// these by hand: the app gets its client id, and a secret when it asks for one,
/// the moment someone pastes the MCP URL into it.
model OAuthClient {
  id                      String    @id @default(cuid())
  clientId                String    @unique
  /// sha256 of the client secret. Empty for public clients, which prove themselves with PKCE alone.
  clientSecretHash        String    @default("")
  clientName              String
  clientUri               String?
  /// Exact-match list; a loopback redirect may use any port (RFC 8252).
  redirectUris            String[]
  /// client_secret_post, client_secret_basic or none.
  tokenEndpointAuthMethod String    @default("client_secret_post")
  createdAt               DateTime  @default(now())
  lastUsedAt              DateTime?

  grants OAuthGrant[]
  codes  OAuthCode[]
  tokens OAuthToken[]
}

/// What one person let one app reach inside one organization. The app acts as
/// that person, with the role they hold there now, so it can never do more
/// than they could in the app themselves.
model OAuthGrant {
  id             String    @id @default(cuid())
  userId         String
  clientId       String
  organizationId String
  /// Empty means every workspace in the organization, including ones added later.
  workspaceIds   String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       OAuthClient  @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId, organizationId])
  @@index([organizationId])
}

/// One-time authorization code from the consent screen, bound to the app, the
/// redirect URI and a PKCE challenge. Stored hashed; lives ten minutes.
model OAuthCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// Access and refresh tokens, stored hashed. Access tokens are opaque and live
/// an hour, so disconnecting an app takes effect on its next call. Refresh
/// tokens rotate; presenting a used one revokes every token of that person and app.
model OAuthToken {
  id            String         @id @default(cuid())
  tokenHash     String         @unique
  kind          OAuthTokenKind
  clientId      String
  userId        String
  expiresAt     DateTime
  revokedAt     DateTime?
  /// The refresh token this one was minted from.
  rotatedFromId String?
  createdAt     DateTime       @default(now())

  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
  @@index([expiresAt])
}

/// Who in an organization may use one MCP tool, as the owner set it in
/// Settings, MCP. With no row the tool's default applies: read-only tools are
/// open to every member, tools that change something to owners only. A row
/// opens the tool to everyone (`allMembers`, including people who join later)
/// or to exactly `userIds`. Roles apply on top either way.
model McpToolAccess {
  id             String   @id @default(cuid())
  organizationId String
  /// The tool's name, such as create_automation.
  tool           String
  allMembers     Boolean  @default(false)
  userIds        String[]
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, tool])
}
