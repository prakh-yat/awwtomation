# ─────────────────────────────────────────────────────────────────────────────
# Awwtomation — environment variables
# Copy to .env (local) or paste into your host's environment settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of this deployment. Used to build OAuth redirect URIs, webhook URLs
# and tracked links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Meta access tokens at rest (AES-256-GCM).
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret for /api/cron/* (token refresh, comment reconciliation, queue tick).
#   openssl rand -hex 24
CRON_SECRET=

# Comma-separated emails that get the platform admin panel (/admin).
SUPER_ADMIN_EMAILS=you@example.com

# ── Supabase (Google sign-in + Postgres) ────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → Database → Connection string
# Pooled (transaction mode, port 6543) for the app at runtime:
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# Direct (port 5432) for prisma migrate / db push:
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Google OAuth is configured INSIDE Supabase (Authentication → Providers → Google).
# The app does not need Google client secrets.

# ── Meta ────────────────────────────────────────────────────────────────────
META_GRAPH_API_VERSION=v25.0

# Facebook app (developers.facebook.com → your app → App settings → Basic).
# Used for: Facebook Login (Pages + Messenger) and webhook signature verification.
META_APP_ID=
META_APP_SECRET=

# Instagram Login product credentials (your app → Instagram → API setup with
# Instagram login → "Instagram app ID" / "Instagram app secret"). These are
# DIFFERENT from the Facebook app id/secret above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Any random string; you type the same value into the Meta webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# ── Optional: transactional email for team invites (Resend) ─────────────────
# Invites always work as copyable links; email is a convenience.
RESEND_API_KEY=
EMAIL_FROM="Awwtomation <no-reply@yourdomain.com>"

# ── Optional: worker tuning ─────────────────────────────────────────────────
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_BATCH_SIZE=10
# COMMENT_POLL_INTERVAL_MS=300000

# ── Local development without Supabase / Docker ─────────────────────────────
# 1) npm run db:local   → embedded Postgres on 127.0.0.1:5433
# 2) point DATABASE_URL + DIRECT_URL at it:
#    postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true
# 3) sign in as any email without Google (only honoured when NODE_ENV=development):
# DEV_AUTH_EMAIL=you@example.com
# 4) npx prisma db push && npm run db:seed   → demo workspace with data

# ── Dodo Payments (billing) ─────────────────────────────────────────────────
# "test" uses test.dodopayments.com, "live" uses live.dodopayments.com. The
# secret key must belong to the same mode.
DODO_MODE=test
# Dashboard → Developer → API keys
DODO_SECRET_KEY=
# Dashboard → Developer → Webhooks → endpoint https://yourdomain.com/api/billing/webhook → signing secret (whsec_…)
DODO_WEBHOOK_SECRET=
# Product ids per plan × interval. Create them in one go:
#   node --env-file=.env scripts/create-dodo-products.mjs
# then paste the printed lines here. Ids differ between test and live mode.
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_ANNUAL=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_ANNUAL=
# Optional: set to "true" only if a production deploy intentionally runs Dodo in test mode.
# DODO_ALLOW_TEST_MODE_IN_PRODUCTION=false

# ── Docker Compose (docs/DEPLOY.md, section B) ──────────────────────────────
# Bundled Postgres credentials. docker-compose.yml overrides DATABASE_URL and
# DIRECT_URL to point at this container, so the values above are ignored there.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=awwtomation
# POSTGRES_PORT=5432          # host port (bound to 127.0.0.1 only)
# WEB_PORT=3000               # host port for the web app
# APP_DOMAIN=app.example.com  # for `docker compose --profile proxy` (Caddy auto-HTTPS)

# ── Deploy metadata (optional) ──────────────────────────────────────────────
# Shown by /api/health. Vercel/Railway/Render inject their own commit variable.
# GIT_COMMIT_SHA=
