# ─────────────────────────────────────────────────────────────────────────────
# Awwtomation: environment variables
# Copy to .env (local) or paste into your host's environment settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of this deployment. Used to build OAuth redirect URIs, webhook URLs
# and tracked links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts Meta access tokens at rest (AES-256-GCM).
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Shared secret for /api/cron/* (token refresh, comment reconciliation, queue tick).
#   openssl rand -hex 24
CRON_SECRET=


# ── Google sign-in ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Application type: Web application
#
# Authorized redirect URIs (add one per environment, must match exactly):
#   https://your-domain.com/auth/callback
#   http://localhost:3000/auth/callback
#
# Authorized JavaScript origins: your NEXT_PUBLIC_APP_URL (no path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Postgres ────────────────────────────────────────────────────────────────
# Any Postgres works. For Supabase: dashboard → Project Settings → Database.
# Put the database in the same region as the app and the worker: every webhook
# runs a dozen queries in a row, so cross-region latency adds up.
#
# Pooled (transaction mode, port 6543) for the app at runtime. connection_limit
# is PER PROCESS, and a serverless host runs many processes at once:
#   web app on Vercel / any serverless host   connection_limit=1
#   web app on one long-running server        connection_limit=5
#   worker (npm run worker)                   connection_limit = WORKER_BATCH_SIZE + 5 (15 by default)
# Set DATABASE_URL separately for the web service and the worker service.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct (port 5432) for prisma migrate / db push:
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Meta ────────────────────────────────────────────────────────────────────
META_GRAPH_API_VERSION=v25.0

# Facebook app (developers.facebook.com → your app → App settings → Basic).
# Used for: Facebook Login (Pages + Messenger) and webhook signature verification.
META_APP_ID=
META_APP_SECRET=

# Instagram Login product credentials (your app → Instagram → API setup with
# Instagram login → "Instagram app ID" / "Instagram app secret"). These are
# DIFFERENT from the Facebook app id/secret above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Any random string; you type the same value into the Meta webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# ── Built-in AI model ───────────────────────────────────────────────────────
# Every workspace can reply with this model without bringing a key of its own;
# workspaces that connect their own provider use theirs instead. Any
# OpenAI-compatible endpoint works. OpenRouter: openrouter.ai → Keys.
# Free models on OpenRouter are rate limited (about 20 requests a minute, and a
# daily cap that depends on your credit balance): fine for testing, not for launch.
DEFAULT_AI_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_API_KEY=
DEFAULT_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional: a second model on the same endpoint, tried once when the main one is
# rate limited, down or returns nothing, so a busy free model does not hand the
# conversation over. Unset, the main model is simply tried again.
DEFAULT_AI_FALLBACK_MODEL=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Tells owners when an Instagram or Facebook account needs reconnecting, and
# OPS_ALERT_EMAIL when the job queue stops moving. Without a key both are only
# logged. Invites always work as copyable links.
RESEND_API_KEY=
EMAIL_FROM="Awwtomation <no-reply@yourdomain.com>"
OPS_ALERT_EMAIL=

# ── Optional: logging ───────────────────────────────────────────────────────
# debug | info | warn | error
# LOG_LEVEL=info

# ── Optional: worker tuning ─────────────────────────────────────────────────
# WORKER_POLL_INTERVAL_MS=2000
# Jobs one worker runs at once:
# WORKER_BATCH_SIZE=10
# Missed-comment polling per account; webhooks deliver comments, this is the safety net:
# COMMENT_POLL_INTERVAL_MS=900000
# /api/health/queue turns 503 (and OPS_ALERT_EMAIL is emailed) once a due job has waited this long:
# QUEUE_ALERT_AFTER_SECONDS=300

# ── Local development without Google / Docker ───────────────────────────────
# 1) npm run db:local   → embedded Postgres on 127.0.0.1:5433
# 2) point DATABASE_URL + DIRECT_URL at it:
#    postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true
# 3) sign in as any email without Google (only honoured when NODE_ENV=development):
# DEV_AUTH_EMAIL=you@example.com
# 4) npx prisma db push && npm run db:seed   → demo workspace with data

# ── Dodo Payments (billing) ─────────────────────────────────────────────────
# "test" uses test.dodopayments.com, "live" uses live.dodopayments.com. The
# secret key must belong to the same mode.
DODO_MODE=test
# Dashboard → Developer → API keys
DODO_SECRET_KEY=
# Dashboard → Developer → Webhooks → endpoint https://yourdomain.com/api/billing/webhook → signing secret (whsec_…)
DODO_WEBHOOK_SECRET=
# Product ids per plan × interval. Create them in one go:
#   node --env-file=.env scripts/create-dodo-products.mjs
# then paste the printed lines here. Ids differ between test and live mode.
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_ANNUAL=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_ANNUAL=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_ANNUAL=
# Optional: set to "true" only if a production deploy intentionally runs Dodo in test mode.
# DODO_ALLOW_TEST_MODE_IN_PRODUCTION=false

# ── Docker Compose (docs/DEPLOY.md, section B) ──────────────────────────────
# Bundled Postgres credentials. docker-compose.yml overrides DATABASE_URL and
# DIRECT_URL to point at this container, so the values above are ignored there.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=awwtomation
# POSTGRES_PORT=5432          # host port (bound to 127.0.0.1 only)
# WEB_PORT=3000               # host port for the web app
# APP_DOMAIN=app.example.com  # for `docker compose --profile proxy` (Caddy auto-HTTPS)

# ── Deploy metadata (optional) ──────────────────────────────────────────────
# Shown by /api/health. Vercel/Railway/Render inject their own commit variable.
# GIT_COMMIT_SHA=
